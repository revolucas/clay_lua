# Ignore everything under bin/
bin/**

# But keep the top-level placeholder
!bin/.gitkeep

# Keep the two subdirectories themselves…
!bin/linux64/
!bin/x64/

# …and ignore their contents except their placeholders
bin/linux64/**
!bin/linux64/.gitkeep

bin/x64/**
!bin/x64/.gitkeep

# Emscripten outputs and the external Lua 5.4 + FFI-Wasm checkout.
/web/build/
/web/dist/
/web/vendor/
/release-artifacts/

# Per-machine audio and IDE project settings.
/alsoft.ini
/clay_lua.geany
